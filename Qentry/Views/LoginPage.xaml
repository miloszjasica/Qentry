<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Qentry.ViewModels"
             x:Class="Qentry.Views.LoginPage"
             Title="Logowanie">

    <ContentPage.BindingContext>
        <viewmodels:LoginViewModel />
    </ContentPage.BindingContext>

    <VerticalStackLayout Padding="30" Spacing="15" VerticalOptions="Center">

        <Label Text="Zaloguj się" FontSize="24" HorizontalOptions="Center" />

        <Entry Placeholder="Email" Text="{Binding Email}" />

        <Entry Placeholder="Hasło" Text="{Binding Password}" IsPassword="True" />

        <Button Text="Zaloguj" Command="{Binding LoginCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />

        <Label Text="{Binding Message}" TextColor="Red" HorizontalOptions="Center" />

        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

    </VerticalStackLayout>
</ContentPage>
