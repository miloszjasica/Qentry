<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:Qentry.Views.Controls"
             xmlns:viewmodels="clr-namespace:Qentry.ViewModels"
             xmlns:views="clr-namespace:Qentry.Views"
             x:Class="Qentry.Views.MyEventsPage"
             BackgroundColor="{StaticResource BgColor}">

    <Grid>
		<ScrollView>
            <VerticalStackLayout>
                <Grid Margin="0, 50, 0, 0">
                    <views:HorizontalCalendarView x:Name="Calendar" SelectedDay="{Binding SelectedDay, Mode=TwoWay}"/>
                </Grid>
                
                <!-- Pole wyszukiwania -->
                <Border StrokeShape="RoundRectangle 28"
                        Stroke="{StaticResource Primary}"
                        StrokeThickness="1"
                        Margin="30, 20">

                    <Grid ColumnDefinitions="Auto, *,Auto"
                          BackgroundColor="Transparent"
                          HeightRequest="40"
                          Padding="20, 0, 0, 0">

                        <ImageButton Source="filter.png"
                                     WidthRequest="24"
                                     HeightRequest="24"
                                     Command="{Binding ToggleFilterPanelCommand}"
                                     BackgroundColor="Transparent"/>

                        <Entry x:Name="SearchEntry"
                               Grid.Column="1"
                               Text="{Binding SearchQuery, Mode=TwoWay}"
                               Placeholder="Wyszukaj wydarzenie"
                               TextColor="Black"/>

                        <ImageButton Grid.Column="2"
                                     Source="search.png"
                                     BackgroundColor="Transparent"
                                     Command="{Binding SearchCommand}"
                                     WidthRequest="24"
                                     HeightRequest="24"/>
                    </Grid>
                </Border>
                
                <StackLayout IsVisible="{Binding IsFilterPanelVisible}"
                             Padding="20"
                             Spacing="10">

                    <Label Text="Filtruj według kategorii:"
                           FontAttributes="Bold"
                           TextColor="Black"/>

                    <CollectionView 
                        ItemsSource="{Binding Categories}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedCategory}">

                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal"/>
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame Padding="8"
                                       Margin="5"
                                       CornerRadius="10"
                                       BackgroundColor="{StaticResource BgColor}"
                                       BorderColor="{StaticResource Primary}">
                                    <Label Text="{Binding}" TextColor="Black"/>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                    </CollectionView>
                    
                    <Label Text="Filtruj według lokalizacji:"
                           FontAttributes="Bold"
                           TextColor="Black"/>

                    <Entry Text="{Binding LocationFilter, Mode=TwoWay}"
                           Placeholder="Wpisz lokalizację"
                           TextColor="Black"/>

                    <Label Text="Filtruj po dacie:"
                           FontAttributes="Bold"
                           TextColor="Black"/>

                    <Entry Text="{Binding ManualDateFilter, Mode=TwoWay}"
                           Placeholder="Wpisz datę (RRRR-MM-DD)"
                           Keyboard="Chat"
                           TextColor="Black"/>

                    <Button Text="Resetuj filtry"
                            Command="{Binding ResetFiltersCommand}"
                            BackgroundColor="#E0E0E0"
                            TextColor="Black"
                            CornerRadius="10"
                            Margin="0,10,0,0"/>
                </StackLayout>

                <!-- Pole Eventow -->
                <Border Background="{StaticResource Primary}"
                        Stroke="{StaticResource Primary}"
                        StrokeThickness="2"
                        MinimumHeightRequest="{Binding ScreenHeight}"
                        StrokeShape="RoundRectangle 50, 50, 0, 0">

                    <Grid>
                        <VerticalStackLayout Margin="0, 20, 0, 0">
                            
                            <!-- Pole przyciskow -->
                            <Border HeightRequest="60"
                                    Stroke="Transparent"
                                    StrokeShape="RoundRectangle 50">
                                
                                <Border BackgroundColor="{StaticResource Quaternary}"
                                        WidthRequest="355"
                                        StrokeShape="RoundRectangle 50"
                                        Stroke="Transparent"
                                        StrokeThickness="0"
                                        HorizontalOptions="Center"
                                        Padding="3">
                                    
                                    <Grid ColumnDefinitions="*,*">
                                        <Border BackgroundColor="{Binding IsCreatedSelected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='Selected'}"
                                                StrokeShape="RoundRectangle 50"
                                                StrokeThickness="0"
                                                HorizontalOptions="Fill"
                                                VerticalOptions="Fill">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding ShowCreatedCommand}"/>
                                            </Border.GestureRecognizers>
                                            <Label Text="Utworzone wydarzenia"
                                                   TextColor="{Binding IsCreatedSelected, Converter={StaticResource BoolToTextColorConverter}}"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   FontAttributes="Bold"/>
                                        </Border>

                                        <Border BackgroundColor="{Binding IsArchivedSelected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='Selected'}"
                                                StrokeShape="RoundRectangle 50"
                                                StrokeThickness="0"
                                                Grid.Column="1"
                                                HorizontalOptions="Fill"
                                                VerticalOptions="Fill">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding ShowArchivedCommand}"/>
                                            </Border.GestureRecognizers>
                                            <Label Text="Archiwum wydarzeń"
                                                   TextColor="{Binding IsArchivedSelected, Converter={StaticResource BoolToTextColorConverter}}"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   FontAttributes="Bold"/>
                                        </Border>
                                    </Grid>
                                    
                                </Border>
                            </Border>
                            <CollectionView ItemsSource="{Binding Events}"
                                            IsVisible="{Binding IsCreatedSelected}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,4">

                                            <Border Stroke="#3A3341"
                                                    StrokeThickness="1"
                                                    Background="#4A4350"
                                                    Padding="14"
                                                    Margin="12,6"
                                                    StrokeShape="RoundRectangle 20"
                                                    Shadow="10,10,15,#00000040">

                                                <Grid ColumnDefinitions="160,*,Auto">

                                                    <Border Grid.Column="0"
                                                            HeightRequest="100"
                                                            WidthRequest="150"
                                                            StrokeThickness="0"
                                                            BackgroundColor="#00000030"
                                                            StrokeShape="RoundRectangle 16">

                                                        <Image Source="{Binding Image}"
                                                               Aspect="AspectFill"
                                                               HeightRequest="100"
                                                               WidthRequest="150"/>
                                                    </Border>

                                                    <VerticalStackLayout Grid.Column="1"
                                                                         Spacing="4"
                                                                         VerticalOptions="Center"
                                                                         Margin="18,0,0,0">

                                                        <Label Text="{Binding Name}"
                                                               FontSize="18"
                                                               TextColor="White"
                                                               FontAttributes="Bold"/>

                                                        <Label Text="{Binding Location}"
                                                               FontSize="14"
                                                               TextColor="#CFCFCF"/>

                                                        <Label Text="{Binding StartDate, StringFormat='{0:dd.MM.yyyy}'}"
                                                               FontSize="14"
                                                               TextColor="#CFCFCF"/>
                                                    </VerticalStackLayout>

                                                    <VerticalStackLayout Grid.Column="2"
                                                                         VerticalOptions="Center"
                                                                         HorizontalOptions="End">

                                                        <Button Text="Usuń"
                                                                BackgroundColor="#7A3D87"
                                                                TextColor="White"
                                                                CornerRadius="12"
                                                                Padding="20,8"
                                                                HeightRequest="38"
                                                                WidthRequest="90"
                                                                FontSize="14"
                                                                Shadow="5,5,10,#00000040"
                                                                Command="{Binding BindingContext.DeleteEventCommand, Source={x:Reference Name=Calendar}}"
                                                                CommandParameter="{Binding Id_Event}"/>
                                                    </VerticalStackLayout>

                                                </Grid>
                                            </Border>

                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>


                            <StackLayout IsVisible="{Binding IsArchivedSelected}" Margin="0,20,0,0">
                                <Label Text="🗄 Archiwum wydarzeń..." FontSize="18"/>

                            </StackLayout>
                            
                            <StackLayout IsVisible="{Binding NoEventsVisible}"
                                         HorizontalOptions="Center"
                                         Margin="0,40">

                                <Image Source="empty.png"
                                       WidthRequest="150"
                                       HeightRequest="150"
                                       Opacity="0.6" />

                                <Label Text="Nie masz żadnych wydarzeń."
                                       FontSize="18"
                                       TextColor="Black"
                                       HorizontalOptions="Center"/>
                            </StackLayout>
                        </VerticalStackLayout>
                        
                    </Grid>
                </Border>
 
            </VerticalStackLayout>
		</ScrollView>
        
        <components:CustomBottomNavBar VerticalOptions="End" />
	</Grid>
</ContentPage>
