<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:Qentry.ViewModels"
    xmlns:components="clr-namespace:Qentry.Views.Controls"
    x:Class="Qentry.Views.MyEventDetailsPage"
    x:Name="DetailsRoot"
    BackgroundColor="{StaticResource Primary}">

    <Grid>

        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="20">

                <Border Stroke="{StaticResource Color3}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="{StaticResource BgColor}">

                    <VerticalStackLayout Padding="20" Spacing="20">

                        <Border Stroke="{StaticResource Primary}"
                                StrokeThickness="2"
                                StrokeShape="RoundRectangle 20">
                            <Image Source="{Binding EventModel.Image}"
                                   HeightRequest="220"
                                   Aspect="AspectFill"/>
                        </Border>

                        <VerticalStackLayout>
                            <Label Text="Nazwa wydarzenia"
                                   FontAttributes="Bold"
                                   FontSize="14"
                                   TextColor="{StaticResource PrimaryDarkText}"/>
                            <Label Text="{Binding EventModel.Name}"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource PrimaryDarkText}"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout>
                            <Label Text="Lokalizacja"
                                   FontAttributes="Bold"
                                   FontSize="14"
                                   TextColor="{StaticResource PrimaryDarkText}"/>
                            <Label Text="{Binding EventModel.Location}"
                                   FontSize="16"
                                   TextColor="{StaticResource Tertiary}"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout>
                            <Label Text="Data"
                                   FontAttributes="Bold"
                                   FontSize="14"
                                   TextColor="{StaticResource PrimaryDarkText}"/>
                            <Label Text="{Binding EventModel.StartDate, StringFormat='{0:dd.MM.yyyy}'}"
                                   FontSize="16"
                                   TextColor="{StaticResource Quaternary}"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="10"
                                             IsVisible="{Binding IsOrganizer}">

                            <Button Text="Edytuj wydarzenie"
                                    Command="{Binding EditEventCommand}"
                                    BackgroundColor="{StaticResource Primary}"
                                    CornerRadius="10"
                                    HeightRequest="45"
                                    TextColor="White"/>

                            <Button Text="Dodaj atrakcję"
                                    Command="{Binding AddAttractionCommand}"
                                    BackgroundColor="{StaticResource PrimaryDark}"
                                    CornerRadius="10"
                                    HeightRequest="45"
                                    TextColor="White"/>

                            <Button Text="Zarządzaj rolami"
                                    Command="{Binding ManageRolesCommand}"
                                    BackgroundColor="{StaticResource Secondary}"
                                    CornerRadius="10"
                                    HeightRequest="45"
                                    TextColor="White"/>
                        </VerticalStackLayout>

                        <Label Text="Atrakcje"
                               FontAttributes="Bold"
                               FontSize="18"
                               Margin="0,10,0,0"
                               TextColor="{StaticResource PrimaryDarkText}"/>

                        <CollectionView ItemsSource="{Binding Attractions}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>

                                    <Border Stroke="{StaticResource Color3}"
                                            StrokeThickness="1.5"
                                            StrokeShape="RoundRectangle 12"
                                            Padding="14"
                                            Margin="0,8"
                                            BackgroundColor="{StaticResource Color3}">

                                        <Grid ColumnDefinitions="*,Auto">

                                            <VerticalStackLayout Spacing="4" BackgroundColor="{StaticResource Color3}">

                                                <Label Text="{Binding Name}"
                                                       FontSize="17"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource BgColor}"/>

                                                <Label Text="{Binding Description}"
                                                       FontSize="14"
                                                       TextColor="{StaticResource BgColor}"
                                                       LineBreakMode="WordWrap"/>

                                                <Label Text="{Binding Price, StringFormat='Cena: {0} zł'}"
                                                       FontSize="14"
                                                       TextColor="{StaticResource Color2}"/>

                                            </VerticalStackLayout>


                                            <Button Text="Edytuj"
                                                    Grid.Column="1"
                                                    BackgroundColor="{StaticResource Secondary}"
                                                    CornerRadius="8"
                                                    TextColor="White"
                                                    VerticalOptions="Center"
                                                    Command="{Binding BindingContext.EditAttractionCommand, Source={x:Reference DetailsRoot}}"
                                                    CommandParameter="{Binding}"
                                                    IsVisible="{Binding BindingContext.IsOrganizer, Source={x:Reference DetailsRoot}}"/>

                                        </Grid>

                                    </Border>

                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </VerticalStackLayout>

                </Border>

                <Grid BackgroundColor="{StaticResource Primary}" HeightRequest="120"/>
            </VerticalStackLayout>
        </ScrollView>

        <components:CustomBottomNavBar VerticalOptions="End" />
    </Grid>

</ContentPage>
