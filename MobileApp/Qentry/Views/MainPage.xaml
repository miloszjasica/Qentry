<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:Qentry.Views.Controls"
             xmlns:conv="clr-namespace:Qentry.Converters"
             x:Class="Qentry.Views.MainPage"
             x:Name="RootPage"
             BackgroundColor="{StaticResource BgColor}">
    <Grid>
        <ScrollView>
            <Grid RowDefinitions="Auto,Auto,*,Auto">
                <VerticalStackLayout Spacing="15" Margin="0, 50, 0, 0" Grid.Row="0">
                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                        <Button Text="◀"
                                Command="{Binding PrevMonthCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource Primary}"
                                FontSize="32"
                                WidthRequest="40"
                                HeightRequest="40"
                                CornerRadius="10"
                                Padding="0"
                                HorizontalOptions="Start"/>

                        <Border Grid.Column="1"
                                BackgroundColor="Transparent"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="0"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                Padding="10,4">
                            <Label Text="{Binding CurrentMonthName}"
                                   FontSize="32"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <Button Text="▶"
                                Command="{Binding NextMonthCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource Primary}"
                                FontSize="32"
                                WidthRequest="40"
                                HeightRequest="40"
                                CornerRadius="10"
                                Padding="0"
                                HorizontalOptions="End"
                                Grid.Column="2"/>
                    </Grid>
                    <Line X1="0" X2="360" 
                          Stroke="{StaticResource Primary}"
                          StrokeThickness="3"
                          HorizontalOptions="Center"/>

                    <Grid ColumnDefinitions="45,45,45,45,45,45,45"
                      ColumnSpacing="8"
                      HorizontalOptions="Center"
                      Margin="0,20,0,0">
                        <Label Text="Pon" HorizontalOptions="Center" TextColor="Black" FontAttributes="Bold"/>
                        <Label Text="Wt" HorizontalOptions="Center" TextColor="Black" FontAttributes="Bold" Grid.Column="1"/>
                        <Label Text="Śr" HorizontalOptions="Center" TextColor="Black" FontAttributes="Bold" Grid.Column="2"/>
                        <Label Text="Czw" HorizontalOptions="Center" TextColor="Black" FontAttributes="Bold" Grid.Column="3"/>
                        <Label Text="Pt" HorizontalOptions="Center" TextColor="Black" FontAttributes="Bold" Grid.Column="4"/>
                        <Label Text="Sob" HorizontalOptions="Center" TextColor="#B0B0B0" FontAttributes="Bold" Grid.Column="5"/>
                        <Label Text="Ndz" HorizontalOptions="Center" TextColor="#B0B0B0" FontAttributes="Bold" Grid.Column="6"/>
                    </Grid>

                    <Grid x:Name="CalendarGrid"
                          ColumnDefinitions="45,45,45,45,45,45,45"
                          ColumnSpacing="8"
                          RowSpacing="8"
                          HorizontalOptions="Center"
                          Margin="0,10,0,0" />
                </VerticalStackLayout>
                
                <!-- Pole wyszukiwania -->
                <Border StrokeShape="RoundRectangle 28"
                        Stroke="{StaticResource Primary}"
                        StrokeThickness="1"
                        Margin="30,20"
                        Grid.Row="1">

                    <Grid ColumnDefinitions="Auto,*,Auto"
                          HeightRequest="40"
                          Padding="20,0,0,0">

                        <ImageButton Source="filter.png"
                                     WidthRequest="24"
                                     HeightRequest="24"
                                     BackgroundColor="Transparent"
                                     Command="{Binding ToggleFilterPanelCommand}" />

                        <Entry x:Name="SearchEntry"
                               Grid.Column="1"
                               Text="{Binding SearchQuery, Mode=TwoWay}"
                               Placeholder="Wyszukaj wydarzenie"
                               TextColor="Black" />

                        <ImageButton Grid.Column="2"
                                     Source="search.png"
                                     WidthRequest="24"
                                     HeightRequest="24"
                                     BackgroundColor="Transparent"
                                     Command="{Binding SearchCommand}" />
                    </Grid>
                </Border>

                <!-- Panel filtrów -->
                <StackLayout Grid.Row="2"
                             IsVisible="{Binding IsFilterPanelVisible}"
                             Padding="20"
                             Spacing="10">

                    <Label Text="Filtruj według kategorii:"
                           FontAttributes="Bold"
                           TextColor="Black" />

                    <CollectionView ItemsSource="{Binding CategoriesPolish}"
                SelectionMode="None">

                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Stroke="{StaticResource Primary}"
                    StrokeThickness="1"
                    Margin="5"
                    Padding="8"
                    StrokeShape="RoundRectangle 10">

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer 
                        Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.SelectCategoryCommand}"
                        CommandParameter="{Binding}" />
                                    </Border.GestureRecognizers>

                                    <Border.Background>
                                        <MultiBinding Converter="{StaticResource CategoryToColorConverter}">
                                            <Binding />
                                            <Binding Path="BindingContext.SelectedCategoryPolish"
                                 Source="{x:Reference RootPage}" />
                                        </MultiBinding>
                                    </Border.Background>

                                    <Label Text="{Binding}" TextColor="Black" />
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Label Text="Filtruj według lokalizacji:"
                           FontAttributes="Bold"
                           TextColor="Black"/>

                    <Entry Text="{Binding LocationFilter, Mode=TwoWay}"
                           Placeholder="Wpisz lokalizację"
                           TextColor="Black"/>

                    <Label Text="Filtruj po dacie:"
                           FontAttributes="Bold"
                           TextColor="Black"/>

                    <Entry Text="{Binding ManualDateFilter, Mode=TwoWay}"
                           Placeholder="Wpisz datę (RRRR-MM-DD)"
                           Keyboard="Chat"
                           TextColor="Black"/>

                    <Button Text="Resetuj filtry"
                            WidthRequest="150"
                            Margin="0,10,0,0"
                            BackgroundColor="{StaticResource Color2}"
                            TextColor="Black"
                            CornerRadius="10"
                            Command="{Binding ResetFiltersCommand}" />
                </StackLayout>
                
                <Border Grid.Row="3"
                        Background="{StaticResource Primary}"
                        Stroke="{StaticResource Primary}"
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 50, 50, 0, 0"
                        Margin="0, 15, 0, 0">

                    <Grid RowDefinitions="Auto, *">

                        <VerticalStackLayout Margin="0, 20, 0, 0">
                            <Border Background="{StaticResource BgColor}"
                                    WidthRequest="350"
                                    HeightRequest="60"
                                    Stroke="Transparent"
                                    StrokeShape="RoundRectangle 50">
                                <Label Text="Wydarzenia" HorizontalOptions="Center" VerticalOptions="Center" FontSize="18" TextColor="Black" FontAttributes="Bold"/>
                            </Border>
                            <Label Text="{Binding SelectedDate, StringFormat='{0:dd MMMM yyyy}' }"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Tertiary}"
                                   Margin="10, 10, 0, 0"/>

                        </VerticalStackLayout>

                        <CollectionView Grid.Row="3"
                                        ItemsSource="{Binding EventVM.Events}"
                                        SelectionMode="Single"
                                        SelectionChanged="OnEventSelected"
                                        Margin="10,20,10,0"
                                        x:Name="MainEventsCollection">

                            <CollectionView.Footer>
                                <Grid HeightRequest="100"/>
                            </CollectionView.Footer>

                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,4">

                                        <Border Background="#4A4350"
                                                Stroke="#3A3341"
                                                StrokeThickness="1"
                                                Padding="14"
                                                Margin="12,6"
                                                Shadow="10,10,15,#00000040"
                                                StrokeShape="RoundRectangle 20">

                                            <Grid ColumnDefinitions="110,*,Auto">

                                                <!-- Miniatura -->
                                                <Border Grid.Column="0"
                                                        HeightRequest="80"
                                                        WidthRequest="150"
                                                        BackgroundColor="#00000030"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 16">
                                                    <Image Source="{Binding Image}"
                                                           Aspect="AspectFill"
                                                           HeightRequest="80"
                                                           WidthRequest="100" />
                                                </Border>

                                                <!-- Informacje -->
                                                <VerticalStackLayout Grid.Column="1"
                                                                     Margin="5,0,0,0"
                                                                     VerticalOptions="Center"
                                                                     Spacing="4">

                                                    <Label Text="{Binding Name}"
                                                           FontSize="18"
                                                           TextColor="White"
                                                           FontAttributes="Bold" />

                                                    <Label Text="{Binding Location}"
                                                           FontSize="14"
                                                           TextColor="#CFCFCF" />

                                                    <Label Text="{Binding StartDate, StringFormat='{0:dd.MM.yyyy}'}"
                                                           FontSize="14"
                                                           TextColor="#CFCFCF" />
                                                </VerticalStackLayout>

                                                <!-- Zapisz się -->
                                                <VerticalStackLayout Grid.Column="2"
                                                                     VerticalOptions="Center"
                                                                     HorizontalOptions="End">

                                                    <Button Text="Zapisz się"
                                                            BackgroundColor="#7A3D87"
                                                            TextColor="White"
                                                            Padding="20,8"
                                                            CornerRadius="12"
                                                            HeightRequest="38"
                                                            WidthRequest="110"
                                                            FontSize="14"
                                                            Shadow="5,5,10,#00000040"
                                                            Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.EventVM.JoinEventCommand}"
                                                            CommandParameter="{Binding}" />
                                                </VerticalStackLayout>

                                            </Grid>

                                        </Border>

                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>

                </Border>

            </Grid>
        </ScrollView>

        <components:CustomBottomNavBar VerticalOptions="End" InputTransparent="False" Margin="0"/>
    </Grid>
</ContentPage>
